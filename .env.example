# Required. The middleware reads these on every request; if either is missing at
# build time the Supabase client throws and every route the matcher covers
# returns MIDDLEWARE_INVOCATION_FAILED. NEXT_PUBLIC_* are inlined at build, so
# they must be set in the Vercel project *before* the build, not after.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Server-side only. Never expose with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Absolute origin used for canonical URLs and redirects.
NEXT_PUBLIC_SITE_URL=https://www.chatkit.cc

# Chat widget keys.
NEXT_PUBLIC_TINYCHAT_KEY=
NEXT_PUBLIC_TINYCHAT_API_KEY=
NEXT_PUBLIC_TINYCHAT_SUPPORT_KEY=
TINYCHAT_KEY=
EXPO_PUBLIC_TINYCHAT_KEY=

# Comma-separated origins allowed to embed the widget iframe.
EMBED_ALLOWED_ORIGINS=
